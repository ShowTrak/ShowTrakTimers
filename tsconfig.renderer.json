{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "noEmit": true,
    "types": ["jquery"],
    "paths": {
      // As tsconfig.json: the protocol's type entry points straight from the
      // submodule's source (the runtime entry point is main-process only).
      "@showtrak/protocol": ["./shared/src/index.d.ts"],
      "@showtrak/protocol/*": ["./shared/src/*"]
    }
  },
  "include": ["src/UI/js/app/**/*", "src/UI/types/**/*", "src/common/**/*"]
}
