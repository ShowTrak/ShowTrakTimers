{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "noEmit": true,
    "types": ["jquery"],
    "paths": {
      // As tsconfig.json: the protocol's type entry points straight from the
      // submodule's source (the runtime entry point is main-process only), and
      // the compiled code the renderers share from its BUILT declarations: the
      // renderer kit, and single modules of the common entry point (a page
      // bundle takes only the module it uses).
      "@showtrak/protocol": ["./shared/src/index.d.ts"],
      "@showtrak/protocol/common/*": ["./shared/dist/common/*"],
      "@showtrak/protocol/ui/*": ["./shared/dist/ui/*"],
      "@showtrak/protocol/*": ["./shared/src/*"]
    }
  },
  "include": [
    "src/UI/js/app/**/*",
    "src/UI/types/**/*",
    "src/common/**/*",
    // Bootstrap and Howler, page globals the renderer kit uses too.
    "shared/src/ui/vendors.d.ts"
  ]
}
